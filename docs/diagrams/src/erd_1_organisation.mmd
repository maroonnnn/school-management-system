erDiagram
  directorates |o--o{ employee_assignments : directorate_id
  schools |o--o{ employee_assignments : school_id
  employees ||--o{ employee_assignments : employee_id
  ministries ||--o{ directorates : ministry_id
  directorates ||--o{ schools : directorate_id
  employees ||--o{ teacher_profiles : employee_id
  roles ||--o{ users : role_id
  users ||--o{ school_deputy_authorizations : authorized_by
  users ||--o{ school_deputy_authorizations : deputy_user_id
  schools ||--o{ school_deputy_authorizations : school_id
  directorates |o--o{ users : directorate_id
  employees |o--o| users : employee_id
  ministries |o--o{ users : ministry_id
  schools |o--o{ users : school_id
  ministries {
    bigint id PK
    varchar name
    varchar country
  }
  directorates {
    bigint id PK
    bigint ministry_id FK
    varchar name
    text address
    varchar phone
  }
  schools {
    bigint id PK
    bigint directorate_id FK
    varchar name
    varchar school_code
    text address
    varchar phone
    boolean is_active
  }
  roles {
    bigint id PK
    varchar name
    text description
  }
  users {
    bigint id PK
    bigint role_id FK
    bigint ministry_id FK
    bigint directorate_id FK
    bigint school_id FK
    varchar full_name
    varchar username
    varchar email
    text password_hash
    boolean is_active
    bigint employee_id FK
  }
  employees {
    bigint id PK
    varchar employee_number
    varchar full_name
    varchar phone
    varchar email
    date hire_date
  }
  employee_assignments {
    bigint id PK
    bigint employee_id FK
    bigint school_id FK
    bigint directorate_id FK
    varchar position_type
    varchar work_schedule_type
    numeric weekly_quota_units
    date start_date
    date end_date
  }
  teacher_profiles {
    bigint employee_id PK
    varchar specialization
    varchar qualification
    integer years_of_experience
    varchar employment_type
    numeric contract_weekly_hours
  }
  school_deputy_authorizations {
    bigint id PK
    bigint school_id FK
    bigint deputy_user_id FK
    bigint authorized_by FK
    timestamptz authorized_at
    timestamptz revoked_at
    boolean is_active
  }
