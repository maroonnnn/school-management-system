erDiagram
  ministries ||--o{ directorates : ministry_id
  directorates ||--o{ schools : directorate_id
  roles ||--o{ users : role_id
  directorates |o--o{ users : directorate_id
  employees |o--o| users : employee_id
  ministries |o--o{ users : ministry_id
  schools |o--o{ users : school_id
  ministries {
    bigint id PK
    varchar name
    varchar country
  }
  directorates {
    bigint id PK
    bigint ministry_id FK
    varchar name
    text address
    varchar phone
  }
  schools {
    bigint id PK
    bigint directorate_id FK
    varchar name
    varchar school_code
    text address
    varchar phone
    boolean is_active
  }
  roles {
    bigint id PK
    varchar name
    text description
  }
  users {
    bigint id PK
    bigint role_id FK
    bigint ministry_id FK
    bigint directorate_id FK
    bigint school_id FK
    varchar full_name
    varchar username
    varchar email
    text password_hash
    boolean is_active
    bigint employee_id FK
  }
  employees {
    bigint id PK
  }
