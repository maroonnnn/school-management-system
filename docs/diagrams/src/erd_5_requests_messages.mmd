  school_requests {
    bigint id PK
    varchar request_number
    bigint school_id FK
    bigint created_by FK
    varchar request_type
    varchar title
    text description
    numeric priority_score
    bigint assigned_to FK
    bigint target_employee_id FK
  }
  request_status_history {
    bigint id PK
    bigint request_id FK
    varchar old_status
    varchar new_status
    bigint changed_by FK
    text notes
    timestamptz changed_at
  }
  request_attachments {
    bigint id PK
    bigint request_id FK
    bigint uploaded_by FK
    varchar file_name
    text file_path
    varchar file_type
    bigint file_size
    timestamptz uploaded_at
  }
  request_comments {
    bigint id PK
    bigint request_id FK
    bigint author_id FK
    text body
  }
  notifications {
    bigint id PK
    bigint school_id FK
    bigint directorate_id FK
    varchar title
    text body
    varchar link
    bigint request_id FK
    bigint message_id FK
    bigint user_id FK
  }
  notification_reads {
    bigint notification_id PK
    bigint user_id PK
    timestamptz read_at
  }
  messages {
    bigint id PK
    varchar kind
    varchar sender_type
    bigint sender_ref_id
    bigint sender_user_id FK
    varchar subject
    text body
    bigint reply_to_id FK
  }
  message_recipients {
    bigint message_id PK
    varchar recipient_type PK
    bigint recipient_ref_id PK
    timestamptz opened_at
    bigint opened_by FK
    timestamptz acknowledged_at
    bigint acknowledged_by FK
  }
  message_attachments {
    bigint id PK
    bigint message_id FK
    varchar file_name
    text file_path
    varchar file_type
    bigint file_size
    timestamptz uploaded_at
  }
  directorates {
    bigint id PK
  }
  employees {
    bigint id PK
  }
  schools {
    bigint id PK
  }
