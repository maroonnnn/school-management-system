erDiagram
  messages ||--o{ message_attachments : message_id
  messages ||--o{ message_recipients : message_id
  messages |o--o{ messages : reply_to_id
  notifications ||--o{ notification_reads : notification_id
  directorates |o--o{ notifications : directorate_id
  messages |o--o{ notifications : message_id
  school_requests |o--o{ notifications : request_id
  schools |o--o{ notifications : school_id
  messages {
    bigint id PK
    varchar kind
    varchar sender_type
    bigint sender_ref_id
    bigint sender_user_id FK
    varchar subject
    text body
    bigint reply_to_id FK
  }
  message_recipients {
    bigint message_id PK
    varchar recipient_type PK
    bigint recipient_ref_id PK
    timestamptz opened_at
    bigint opened_by FK
    timestamptz acknowledged_at
    bigint acknowledged_by FK
  }
  message_attachments {
    bigint id PK
    bigint message_id FK
    varchar file_name
    text file_path
    varchar file_type
    bigint file_size
    timestamptz uploaded_at
  }
  notifications {
    bigint id PK
    bigint school_id FK
    bigint directorate_id FK
    varchar title
    text body
    varchar link
    bigint request_id FK
    bigint message_id FK
    bigint user_id FK
  }
  notification_reads {
    bigint notification_id PK
    bigint user_id PK
    timestamptz read_at
  }
  directorates {
    bigint id PK
  }
  school_requests {
    bigint id PK
  }
  schools {
    bigint id PK
  }
